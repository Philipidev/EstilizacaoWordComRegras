<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\WordComplianceValidator.Application.csproj" />
    <ProjectReference Include="..\Core\WordComplianceValidator.Core.csproj" />
    <ProjectReference Include="..\Infrastructure\WordComplianceValidator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WordComplianceValidator.Cli</RootNamespace>
    <!-- Nome que a pessoa ve no Explorer e na barra de tarefas. -->
    <AssemblyName>Revisor</AssemblyName>
  </PropertyGroup>

  <!-- O checklist e os profiles viajam junto do executável publicado: quem recebe o .exe não
       tem o repositório, e o LocalizadorDeRecursos procura a partir da pasta do binário. -->
  <ItemGroup>
    <Content Include="..\..\templates\checklists\*.xlsx"
             Link="templates\checklists\%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest"
             CopyToOutputDirectory="Never" />
    <Content Include="..\..\profiles\*.json"
             Link="profiles\%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Não rastreado pelo git (.gitignore). Guarda a OPENAI_API_KEY local;
         precisa ser copiado porque Program.cs lê de AppContext.BaseDirectory. -->
    <None Update="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Obrigatorio: sem isto a OPENAI_API_KEY entra no pacote publicado e e distribuida
           junto com o executavel para todo mundo que receber o programa. -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
