<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\WordComplianceValidator.Application.csproj" />
    <ProjectReference Include="..\Core\WordComplianceValidator.Core.csproj" />
    <ProjectReference Include="..\Infrastructure\WordComplianceValidator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Só o que o Program.cs usa: JSON + variáveis de ambiente + Bind. O Microsoft.Extensions.Hosting
         entrava inteiro (DI, logging, host genérico) só para trazer esses três de carona, e
         engordava o executável autocontido. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>WordComplianceValidator.Cli</RootNamespace>
    <!-- Nome que a pessoa ve no Explorer e na barra de tarefas. -->
    <AssemblyName>Revisor</AssemblyName>
    <!-- Mostrada na tela de boas-vindas do modo guiado e na opção de versão, sem o hash do commit. -->
    <Version>2.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Só os textos em português das bibliotecas vão para o pacote (os do System.CommandLine). -->
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- O checklist e os profiles viajam junto do executável publicado: quem recebe o .exe não
       tem o repositório, e o LocalizadorDeRecursos procura a partir da pasta do binário. -->
  <ItemGroup>
    <Content Include="..\..\templates\checklists\*.xlsx"
             Link="templates\checklists\%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest"
             CopyToOutputDirectory="Never" />
    <Content Include="..\..\profiles\*.json"
             Link="profiles\%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest"
             CopyToOutputDirectory="Never" />
    <!-- Tutorial para quem recebe o pacote: abre no navegador, sem internet. -->
    <Content Include="..\..\distribuicao\*.html"
             Link="%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Não rastreado pelo git (.gitignore). Guarda a OPENAI_API_KEY local;
         precisa ser copiado porque Program.cs lê de AppContext.BaseDirectory. -->
    <None Update="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Obrigatorio: sem isto a OPENAI_API_KEY entra no pacote publicado e e distribuida
           junto com o executavel para todo mundo que receber o programa. -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Pacote para a equipe com a IA já configurada: publicar.ps1 -EmbutirChave passa
       EmbutirChave=true e o appsettings.Development.json entra DENTRO do executável, como
       recurso. Sem a propriedade (build, testes, publicação comum) nada é embutido.
       Quem tiver o .exe consegue extrair a chave: use uma chave própria para isso, com
       limite de gasto, e revogue-a se o arquivo sair da equipe. -->
  <ItemGroup Condition="'$(EmbutirChave)' == 'true'">
    <EmbeddedResource Include="appsettings.Development.json" LogicalName="Revisor.ConfiguracaoEmbutida.json" />
  </ItemGroup>
  <Target Name="ExigirChaveParaEmbutir" BeforeTargets="BeforeBuild" Condition="'$(EmbutirChave)' == 'true' And !Exists('appsettings.Development.json')">
    <Error Text="EmbutirChave=true, mas src/Cli/appsettings.Development.json não existe." />
  </Target>

</Project>
