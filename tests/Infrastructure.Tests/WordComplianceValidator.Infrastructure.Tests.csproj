<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3: cada projeto de teste é um executável. -->
    <OutputType>Exe</OutputType>
    <!-- Runner do Microsoft.Testing.Platform: é o que carrega extensões como o coverlet.MTP. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\WordComplianceValidator.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Core\WordComplianceValidator.Core.csproj" />
    <!-- O CLI entra como referência para que CliExitCodeTests possa executá-lo como processo.
         O exit code só é observável no nível do processo: um teste unitário não pegaria o bug
         em que Environment.ExitCode era sobrescrito pelo retorno de InvokeAsync. -->
    <ProjectReference Include="..\..\src\Cli\WordComplianceValidator.Cli.csproj" />
  </ItemGroup>

</Project>
