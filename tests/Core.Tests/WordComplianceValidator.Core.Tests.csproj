<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3: cada projeto de teste é um executável. -->
    <OutputType>Exe</OutputType>
    <!-- Runner do Microsoft.Testing.Platform: é o que carrega extensões como o coverlet.MTP. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\WordComplianceValidator.Core.csproj" />
  </ItemGroup>

</Project>
