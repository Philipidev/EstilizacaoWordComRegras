<Project>

  <!-- Versões de pacote num lugar só (Central Package Management). O DocumentFormat.OpenXml
       aparecia em dois projetos com a versão repetida — e um descompasso entre o que o
       extrator usa e o que os testes usam para montar os .docx não dá erro de build. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Aplicação">
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <!-- AwesomeAssertions é o fork Apache-2.0 do FluentAssertions. A partir da 8, o
         FluentAssertions exige licença paga para uso comercial. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <!-- xUnit v3 roda sobre o Microsoft.Testing.Platform (ver global.json): o Test SDK, o
         adaptador VSTest e o coverlet.collector — todos do modelo VSTest — não são mais
         necessários. A cobertura vem do coverlet.MTP (opção "coverlet" do dotnet test). -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

</Project>
