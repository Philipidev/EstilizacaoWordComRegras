<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- O projeto só usa pacotes públicos. Sem isto, o restore herda as fontes da máquina
       (feeds privados inclusive) e o build depende de credenciais que nada têm a ver com ele. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
